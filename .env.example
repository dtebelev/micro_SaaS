# ============================================================
#  NaturoPin — переменные окружения
#  Скопируйте этот файл в  .env  и подставьте реальные значения.
#  .env в .gitignore и НИКОГДА не попадёт в git.
# ============================================================

# ---- ФРОНТЕНД (Vite, попадают в браузер — только ПУБЛИЧНЫЕ) ----
# Project URL из Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
# anon (public) key — защищён Row Level Security, безопасен для браузера
VITE_SUPABASE_ANON_KEY=ВАШ_ANON_KEY

# ---- СЕРВЕР (Node API / Edge Functions — СЕКРЕТНЫЕ, во фронт НЕ идут) ----
# Те же URL/anon дублируем без префикса VITE_ для серверных скриптов
SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
SUPABASE_ANON_KEY=ВАШ_ANON_KEY
# service_role обходит RLS. ТОЛЬКО сервер. Никогда во фронтенд.
SUPABASE_SERVICE_ROLE_KEY=ВАШ_SERVICE_ROLE_KEY

# ---- AI-ключи (секретные, только сервер) ----
# Включить настоящую генерацию (LLM + FLUX). 0 или пусто = стаб-фон без ключей.
USE_REAL_AI=0

# OpenRouter — текстовая нейросеть-«методист» (разбор статьи → JSON карточек)
OPENROUTER_API_KEY=
# Модель по умолчанию (экономичная, хорошо держит русский). Можно сменить.
OPENROUTER_MODEL=openai/gpt-4o-mini

# fal.ai FLUX-2/flash — фон-иллюстрация БЕЗ текста
FLUX_API_KEY=
FLUX_PROVIDER=fal
FLUX_MODEL=fal-ai/flux-2/flash

# ---- Прочее ----
# Сколько карточек генерировать за один прогон
CARDS_COUNT=6
# Порт локального Node API
API_PORT=8787

# ---- Монетизация (кнопка PayPal на UI) ----
# false/пусто = сайт НЕ просит оплату у посетителей (некоммерческое личное
# использование → можно жить на бесплатном Vercel Hobby). true = вернуть кнопку
# подписки на экран «Источник» — тогда сначала перейти на Vercel Pro ($20/мес),
# см. HANDOFF.md → «Монетизация выключена».
VITE_MONETIZATION_ENABLED=false

# ---- PayPal Subscriptions (оплата, только сервер, кроме VITE_-ключа) ----
# developer.paypal.com/dashboard → Apps & Credentials → Sandbox → создать app.
# Начинай с sandbox — тестовые "деньги", без реальных платежей.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# developer.paypal.com/dashboard → твой app → Webhooks → Add Webhook.
# URL: https://ТВОЙ-ДОМЕН/api/paypal-webhook, события — "All events".
PAYPAL_WEBHOOK_ID=
# developer.paypal.com/dashboard → Product & Plans → создать Product + Billing Plan.
PAYPAL_PLAN_ID=
# Те же client_id/plan_id, но публичные — идут в браузер (нужны PayPal-кнопке).
# Не секреты, просто идентификаторы — как VITE_SUPABASE_ANON_KEY.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID=

# ---- Экран /admin (выдача купонов вручную) ----
# Только этот email получает доступ к /admin. Не секрет — просто адрес.
# Проверка — на сервере; VITE_-копия только чтобы показать пункт меню в UI.
ADMIN_EMAIL=
VITE_ADMIN_EMAIL=
